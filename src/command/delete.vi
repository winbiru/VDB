nhập optimizer.statistics.*;
nhập constants.*;
nhập records.*;
nhập command.common.*;
nhập command.index.*;
nhập gói.văn bản.chuỗi.độ dài;

hàm công khai phân tích delete(bộ) {
    bộ.cần(SQL_FROM());
    tênBảng = bộ.tên định danh();
    trả về bản ghi lệnh xóa(SQL_DELETE(), tênBảng, bộ.điều kiện());
};

hàm công khai thực thi delete(máy, cmd) {
    bảng = tìm bảng(máy, cmd[KEY_NAME()]);
    cột = bảng[KEY_COLUMNS()];
    hàng = bảng[KEY_ROWS()];
    điềuKiện = biên dịch điều kiện(cột, cmd[KEY_WHERE()]);
    ds = []; đãXóa = []; ánhXạ = [];
    n = 0;
    lặp(i = 0; i < độ dài(hàng); i++) {
        nếu (khớp(hàng[i], điềuKiện)) { n++; thêm(đãXóa, i); thêm(ánhXạ, -1); }
        hoặc { thêm(ánhXạ, độ dài(ds)); thêm(ds, hàng[i]); };
    };
    bảng[KEY_ROWS()] = ds;
    xóa các index(bảng, hàng, đãXóa, ánhXạ);
    nếu (n > 0) { hủy thống kê(bảng); };
    máy.dirty = đúng;
    trả về thay đổi(n);
};

