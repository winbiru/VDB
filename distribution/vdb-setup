#!/bin/sh
# Install immutable program versions in the user's home. Catalogs live elsewhere.
set -eu
umask 077
payload=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
install_root=${VDB_INSTALL_ROOT:-"$HOME/.local/share/vdb-program"}
bin_dir=${VDB_BIN_DIR:-"$HOME/.local/bin"}
apps_dir=${VDB_APPLICATIONS_DIR:-"$HOME/Applications"}
repository=https://github.com/winbiru/VDB
command=${1:-}
[ "$#" -gt 0 ] && shift
yes=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --yes) yes=1 ;;
        *) echo "Tùy chọn không hợp lệ: $1" >&2; exit 2 ;;
    esac
    shift
done

message() { printf '%s\n' "$1"; }
fail() {
    printf '%s\n' "$1" >&2
    exit 1
}
confirm() {
    if [ "$yes" -eq 1 ]; then return 0; fi
    printf '%s\n%s [y/N] ' "$1" "$2"
    read -r answer || return 1
    case "$answer" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}
checksum() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi
}
valid_version() {
    printf '%s\n' "$1" | grep -Eq '^(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})$'
}
newer() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        split(a,x,"."); split(b,y,".");
        for(i=1;i<=3;i++){if(x[i]+0>y[i]+0)exit 0;if(x[i]+0<y[i]+0)exit 1}
        exit 1
    }'
}
case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) platform=macos-arm64; cli_path='VDB Studio.app/Contents/Resources/vdb'
        data_dir=${VDB_STUDIO_DATA_DIR:-"$HOME/Library/Application Support/VDB Studio"} ;;
    Linux-x86_64) platform=linux-x64; cli_path=vdb
        data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/vdb" ;;
    *) fail 'VDB chưa có gói phát hành cho nền tảng này.' ;;
esac
case "$install_root:$bin_dir:$apps_dir" in
    *'
'*) fail 'Đường dẫn cài đặt không được chứa ký tự xuống dòng.' ;;
esac
for dir in "$install_root" "$bin_dir" "$apps_dir"; do
    case "$dir" in /*) ;; *) fail 'Đường dẫn cài đặt phải là đường dẫn tuyệt đối.' ;; esac
done
current_version() {
    if [ -L "$install_root/current" ]; then
        [ -f "$install_root/current/VERSION" ] || fail 'Bản cài hiện tại bị thiếu VERSION.'
        installed=$(cat "$install_root/current/VERSION")
        valid_version "$installed" || fail 'Phiên bản đang cài không hợp lệ.'
        [ "$(readlink "$install_root/current")" = "versions/$installed" ] &&
            [ ! -L "$install_root/versions/$installed" ] || fail 'Liên kết current không thuộc VDB.'
        printf '%s\n' "$installed"
    elif [ -e "$install_root/current" ]; then
        fail 'Đường dẫn current không thuộc VDB.'
    else
        printf '0.0.0\n'
    fi
}
# Single-quote a path when generating the CLI shim.
shell_quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
check_shortcuts() {
    if [ -e "$bin_dir/vdb" ] || [ -L "$bin_dir/vdb" ]; then
        [ ! -L "$bin_dir/vdb" ] && [ -f "$bin_dir/vdb" ] &&
            grep -Fxq '# VDB managed launcher' "$bin_dir/vdb" &&
            grep -Fxq "root=$(shell_quote "$install_root")" "$bin_dir/vdb" ||
            fail "Không ghi đè launcher hiện có: $bin_dir/vdb"
    fi
    if [ "$platform" = macos-arm64 ]; then
        for app in 'VDB Studio.app' 'VDB Update.app'; do
            target="$install_root/current/$app"
            if [ -e "$apps_dir/$app" ] || [ -L "$apps_dir/$app" ]; then
                [ -L "$apps_dir/$app" ] && [ "$(readlink "$apps_dir/$app")" = "$target" ] ||
                    fail "Không ghi đè ứng dụng hiện có: $apps_dir/$app"
            fi
        done
    fi
}
install_payload() {
    source=$1
    version=$(cat "$source/VERSION")
    valid_version "$version" || fail 'Phiên bản gói không hợp lệ.'
    [ "$(cat "$source/PLATFORM")" = "$platform" ] || fail 'Gói không đúng nền tảng.'
    [ -x "$source/$cli_path" ] || fail 'Thiếu CLI trong gói.'
    mkdir -p "$install_root/versions" "$bin_dir"
    [ "$platform" != macos-arm64 ] || mkdir -p "$apps_dir"
    lock="$install_root/.install-lock"
    mkdir "$lock" 2>/dev/null || fail 'Một tiến trình cài đặt khác đang chạy.'
    stage=''
    shim=''
    link=''
    cleanup() {
        [ -z "$stage" ] || rm -rf "$stage"
        [ -z "$shim" ] || rm -f "$shim"
        [ -z "$link" ] || rm -f "$link"
        rmdir "$lock"
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    old=$(current_version)
    valid_version "$old" || fail 'Phiên bản đang cài không hợp lệ.'
    [ "$old" = "$version" ] || newer "$version" "$old" || fail "Không hạ cấp từ $old xuống $version."
    check_shortcuts
    action='Cài đặt'
    [ "$old" = 0.0.0 ] || action='Cập nhật'
    [ "$old" != "$version" ] || action='Sửa bản cài'
    confirm "$action VDB $version
Phiên bản hiện tại: $old
Thư mục chương trình: $install_root
CLI: $bin_dir/vdb

Dữ liệu và cấu hình Studio được giữ nguyên. Hãy đóng VDB Studio trước khi tiếp tục." "$action" || exit 0
    # Share the Studio state lock to prevent a session during publication.
    mkdir -p "$data_dir"
    exec 9>>"$data_dir/studio-state.json.lock"
    case "$platform" in
        macos-arm64) lockf -s -t 0 9 || fail 'Hãy đóng VDB Studio trước khi cài đặt hoặc cập nhật.' ;;
        linux-x64) flock -n 9 || fail 'Hãy đóng VDB Studio trước khi cài đặt hoặc cập nhật.' ;;
    esac
    final="$install_root/versions/$version"
    stage=$(mktemp -d "$install_root/versions/.stage.XXXXXXXX")
    cp -R "$source/." "$stage/"
    [ "$("$stage/$cli_path" --version)" = "VDB $version" ] || fail 'Kiểm tra phiên bản thất bại.'
    probe="$stage/.install-probe.json"
    "$stage/$cli_path" --db "$probe" -e 'CREATE TABLE probe (id INT); INSERT INTO probe VALUES (42); SELECT * FROM probe;' | grep -Fq '"rows":[[42]]' || fail 'Kiểm tra engine thất bại.'
    rm -f "$probe"
    if [ "$platform" = macos-arm64 ]; then
        "$stage/VDB Studio.app/Contents/MacOS/launch-vdb-studio" --check >/dev/null
        "$stage/VDB Update.app/Contents/MacOS/setup" --check
    else
        [ -x "$stage/build/vdb-studio" ] && [ -r "$stage/studio/index.html" ] &&
            [ -r "$stage/studio/serve" ] || fail 'Gói thiếu thành phần Studio.'
    fi
    if [ -e "$final" ] || [ -L "$final" ]; then
        [ -d "$final" ] && [ ! -L "$final" ] && diff -qr "$stage" "$final" >/dev/null ||
            fail "Thư mục phiên bản đã tồn tại với nội dung khác: $final"
    else
        mv "$stage" "$final"
        stage=''
    fi
    shim=$(mktemp "$bin_dir/.vdb.XXXXXXXX")
    {
        printf '#!/bin/sh\n# VDB managed launcher\nroot=%s\n' "$(shell_quote "$install_root")"
        printf 'active=$(CDPATH= cd -- "$root/current" && pwd -P) || exit 1\n'
        printf 'if [ "${1:-}" = update ]; then shift; exec "$active/vdb-setup" update "$@"; fi\n'
        printf 'exec "$active/%s" "$@"\n' "$cli_path"
    } > "$shim"
    chmod 755 "$shim"
    # Prepare managed shortcuts before switching the active version.
    check_shortcuts
    mv -f "$shim" "$bin_dir/vdb"
    shim=''
    if [ "$platform" = macos-arm64 ]; then
        for app in 'VDB Studio.app' 'VDB Update.app'; do
            [ -L "$apps_dir/$app" ] || ln -s "$install_root/current/$app" "$apps_dir/$app"
        done
    fi
    # Publish the active version with a same-filesystem rename.
    link="$install_root/.current.$$"
    ln -s "versions/$version" "$link"
    case "$platform" in
        macos-arm64) mv -fh "$link" "$install_root/current" ;;
        linux-x64) mv -Tf "$link" "$install_root/current" ;;
    esac
    link=''
    message "Đã $action VDB $version thành công.
CLI: $bin_dir/vdb
Thêm $bin_dir vào PATH nếu cần.
Dữ liệu và phiên bản chương trình trước đó được giữ lại."
}
case "$command" in
    install) install_payload "$payload" ;;
    update)
        old=$(current_version)
        valid_version "$old" || fail 'Phiên bản đang cài không hợp lệ.'
        [ "$old" != 0.0.0 ] || fail 'Hãy cài VDB trước khi cập nhật.'
        latest=$(curl --proto '=https' --tlsv1.2 -fsSL --max-time 60 -o /dev/null -w '%{url_effective}' "$repository/releases/latest") || fail 'Không thể kiểm tra GitHub Releases.'
        case "$latest" in "$repository/releases/tag/v"*) version=${latest##*/v} ;; *) fail 'Không tìm thấy release ổn định.' ;; esac
        valid_version "$version" || fail 'Tag release không hợp lệ.'
        if ! newer "$version" "$old"; then message "VDB $old đang là phiên bản mới nhất khả dụng."; exit 0; fi
        confirm "Có bản cập nhật VDB $version (đang dùng $old).
Tải từ GitHub Releases và xác minh SHA-256?" 'Tải bản cập nhật' || exit 0
        work=$(mktemp -d "${TMPDIR:-/tmp}/vdb-update.XXXXXXXX")
        trap 'rm -rf "$work"' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        asset="vdb-$platform.tar.gz"
        for file in "$asset" "$asset.sha256"; do
            curl --proto '=https' --tlsv1.2 -fSL --retry 2 --max-time 300 -o "$work/$file" "$repository/releases/download/v$version/$file"
        done
        expected=$(awk 'NR==1 {print $1}' "$work/$asset.sha256")
        actual=$(checksum "$work/$asset" | awk '{print $1}')
        [ "$actual" = "$expected" ] || fail 'Checksum không khớp; hủy cập nhật.'
        # Release archives contain only regular files and directories under one root.
        tar -tzf "$work/$asset" > "$work/entries"
        awk -v prefix="vdb-$platform" '
            $0 != prefix && index($0, prefix "/") != 1 {exit 1}
            /(^|\/)\.\.(\/|$)/ {exit 1}
            END {if (NR == 0) exit 1}
        ' "$work/entries" || fail 'Đường dẫn trong gói cập nhật không hợp lệ.'
        tar -tvzf "$work/$asset" > "$work/types"
        awk 'substr($0,1,1) !~ /^[-d]$/ {exit 1}' "$work/types" ||
            fail 'Gói cập nhật chứa loại tệp không được phép.'
        tar -xzf "$work/$asset" -C "$work"
        [ "$(cat "$work/vdb-$platform/payload/VERSION")" = "$version" ] || fail 'Phiên bản trong gói không khớp release.'
        # Separate process keeps the download cleanup independent of installation.
        set --
        [ "$yes" -eq 0 ] || set -- "$@" --yes
        "$work/vdb-$platform/install.sh" "$@"
        ;;
    *) fail 'Usage: vdb-setup install|update [--yes]' ;;
esac
